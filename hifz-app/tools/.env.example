# Copiez ce fichier en hifz-app/.env et renseignez votre clé (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Réglages facultatifs (valeurs par défaut ci-dessous)
# TAFSIR_MODEL=claude-opus-5-5
# TAFSIR_EFFORT=high
# Modèle qui identifie les versets de chaque page échantillonnée (tâche simple : claude-haiku-5-5 la fait pour bien moins cher)
# TAFSIR_INDEX_MODEL=claude-opus-5-5
# TAFSIR_INDEX_STEP=6
# TAFSIR_INDEX_WORKERS=6
# Repli serveur vers un autre modèle si une requête est déclinée (0 pour désactiver)
# TAFSIR_FALLBACKS=1
# Largeur max (px) et qualité JPEG des pages envoyées à la vision : 800 px ≈ 1200 jetons/page
# TAFSIR_IMG_WIDTH=800
# TAFSIR_IMG_QUALITY=68
